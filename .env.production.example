# Référence pour Coolify / VPS. Ne jamais mettre les vraies valeurs secrètes dans Git.

POSTGRES_DB=bko_services
POSTGRES_USER=bko_services
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DATABASE_PASSWORD

DJANGO_SECRET_KEY=CHANGE_ME_LONG_RANDOM_DJANGO_SECRET
DJANGO_DEBUG=False
# Remplacer bko.example.com par le vrai domaine. Garder localhost/127.0.0.1 pour le healthcheck interne.
DJANGO_ALLOWED_HOSTS=bko.example.com,backend,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://bko.example.com
DJANGO_COOKIE_SECURE=True
# Coolify peut gérer la redirection HTTP -> HTTPS au proxy. Activer ici seulement après validation du domaine/proxy.
DJANGO_SECURE_SSL_REDIRECT=False
# Laisser HSTS à 0 pendant la première mise en ligne, puis l'activer après validation HTTPS complète.
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False
DB_CONN_MAX_AGE=60
RUN_MIGRATIONS=true
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60

WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:admin@bko.example.com

SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=
SMS_HTTP_TIMEOUT_SECONDS=5
SMS_OTP_IP_LIMIT_PER_HOUR=20

PAYMENT_PROVIDER=GENERIC
PAYMENT_WEBHOOK_SECRET=
WAVE_API_KEY=
WAVE_WEBHOOK_SECRET=
PAYMENT_RETURN_ORIGIN=https://bko.example.com
