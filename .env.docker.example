# Copiez ce fichier en .env.docker pour tester BKO Services avec Docker en local.
# Ce fichier est prévu pour le poste de développement, pas pour le VPS.

COMPOSE_PROJECT_NAME=bko_services
BKO_FRONTEND_PORT=3001
BKO_BACKEND_PORT=8001

POSTGRES_DB=bko_services_docker
POSTGRES_USER=bko_services_docker
POSTGRES_PASSWORD=bko-local-docker-password-change-me

DJANGO_SECRET_KEY=bko-local-docker-secret-change-me-before-production-2026
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
DJANGO_COOKIE_SECURE=False
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False
DB_CONN_MAX_AGE=60
RUN_MIGRATIONS=true
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60

WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=

SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=
SMS_HTTP_TIMEOUT_SECONDS=5
SMS_OTP_IP_LIMIT_PER_HOUR=20

# Garder GENERIC en local tant qu'aucun domaine HTTPS public et aucune clé de test CinetPay ne sont disponibles.
PAYMENT_PROVIDER=GENERIC
PAYMENT_WEBHOOK_SECRET=
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_SECRET_KEY=
CINETPAY_CHANNELS=MOBILE_MONEY
CINETPAY_HTTP_TIMEOUT_SECONDS=8
WAVE_API_KEY=
WAVE_WEBHOOK_SECRET=
PAYMENT_RETURN_ORIGIN=
